# Copy to .env.local for a local demo. None of the active values below are secret keys.
# The merchant value is a public Solana address. A payer key, if you add one, stays in .env.local only.
# Nothing here is required at build time. Unset values keep the devnet defaults in src/config/solana.ts.

# --- Local demo (devnet) ---

# devnet (default) or mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Server-only. The browser never sees this URL. Locally, leave it unset and the public cluster URL is used.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Public address that receives USDC. Defaults to the demo address in src/config/solana.ts if empty.
NEXT_PUBLIC_MERCHANT_WALLET=7WeLc3qZEnnYWfXGxCeRTSqbKkHaeAmUb741wbkSGMAP

# Optional. Leave unset and the cluster picks Circle's mint:
# devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# A leftover devnet mint is ignored when the cluster is mainnet-beta.
# NEXT_PUBLIC_USDC_MINT=

# Optional. If set, this GBP-to-USDC rate is used and the live feeds are skipped.
# GBP_USDC_RATE=1.27

# Optional path for the local order file. Leave unset. Local dev writes data/orders.json.
# On Vercel, leave this unset. Checkout refuses the order unless Redis is configured.
# ORDERS_FILE=

# Local script only (scripts/pay-latest.mjs). Never set this on Vercel.
# PAYER_SECRET_BASE64=

# --- Production, set in the Vercel project (do not copy these over the local demo) ---
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# NEXT_PUBLIC_MERCHANT_WALLET=4F9pgnHjQETyYcjz7tm8NvdV9VZuDRuHbZuiXb77sPBF
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
# NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Leave GBP_USDC_RATE and ORDERS_FILE unset.
# Do not set NEXT_PUBLIC_SOLANA_RPC_URL. Delete it if an older deploy still has it, and rotate that key.
# SOLANA_RPC_URL, ADMIN_PASSWORD, CRON_SECRET, RESEND_API_KEY, RESEND_FROM, KV_REST_API_TOKEN,
# and BLOB_READ_WRITE_TOKEN are server-only.
# ADMIN_PASSWORD=
# CRON_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=
#
# Durable orders and print files. Provision both on the Vercel project, then redeploy.
# Upstash Redis, from the Vercel Marketplace (free tier). Linking the integration sets:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# A direct Upstash database may set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN instead.
# The shop accepts either pair. Prefer the KV_ names from the Marketplace.
#
# Vercel Blob, Private, on the same project. Linking the store sets:
# BLOB_READ_WRITE_TOKEN=
# Vercel also sets BLOB_STORE_ID. Keep both. The read-write token is what client uploads use.
# Do not put print files in Redis. Customer uploads are capped at 25MB.
# Without Redis, production checkout returns 503. It does not write orders to /tmp.
